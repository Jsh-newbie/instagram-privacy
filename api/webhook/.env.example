# Instagram Graph API
# 토큰 자체는 ./data/ig-token.txt 파일에 저장 (이 파일은 git에서 제외)
# 처음에 한 번만 IG_TOKEN으로 시작 토큰 주입 → 이후엔 토큰 파일 사용
IG_USER_ID=17841448362073816

# 키워드 매칭 (댓글 본문에 이 단어가 있으면 자동 응답)
KEYWORD=자료

# Webhook 검증 토큰 (Meta 대시보드에 등록한 값)
VERIFY_TOKEN=thejiniuslab-verify-2026

# (선택) 답장 메시지 — 비우면 webhook.mjs의 기본값 사용
# REPLY_MESSAGE=안녕하세요! 자료 링크입니다 → https://thejiniuslab.com/library/
